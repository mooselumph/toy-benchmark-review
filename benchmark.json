{
  "schemaVersion": 1,
  "name": "toy-number",
  "description": "A toy benchmark that scores twice the sum of numbers from an editable file and directory.",
  "category": "python",
  "direction": "+",
  "editablePaths": ["submission/score.txt", "numbers"],
  "setupCommand": ["python3", "-m", "venv", ".venv"],
  "benchmarkCommand": [".venv/bin/python", "benchmark.py"],
  "scorePath": "score.json",
  "maxSubmissionBytes": 1024,
  "runner": {
    "provider": "github-actions",
    "workflow": "benchmark.yml"
  }
}
